# Deployment configuration
# Copy this to .env and fill in your droplet IP
# Never commit .env to git

DROPLET_IP=your_droplet_ip_here

# Supabase: the standalone "sfedits" project (sfedits#7). The bot records each
# published edit there; the SF Daily Brief site reads it. Values are on the
# project's Settings > API Keys page.
#
# The bot uses SUPABASE_URL and SUPABASE_SECRET_KEY. That key bypasses RLS, but
# this project holds one table and nothing else, so its reach is the edit log.
# SUPABASE_PUBLISHABLE_KEY is the site's read key, recorded here for reference.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
